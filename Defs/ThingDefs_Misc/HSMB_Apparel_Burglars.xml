<Defs>

  <ThingDef ParentName="DankPyon_HatMakeableBase">
    <defName>HSMB_Apparel_NightCowl</defName>
    <label>night cowl</label>
    <description>A dark cloth hood worn by cutpurses, scouts, and anyone else who would rather be mistaken for a shadow.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Headgear/Hood/Hood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.06</Mass>
      <StuffEffectMultiplierArmor>0.18</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.45</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.00</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MeleeDodgeChance>0.01</MeleeDodgeChance>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Headgear/Hood/Hood</wornGraphicPath>
      <tags>
        <li>HSMB_NightBurglar</li>
        <li>DankPyon_BrigandThug</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.05,0.055,0.06)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.09,0.075,0.055)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.10,0.10,0.12)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>HSMB_Apparel_DarkPaddedVest</defName>
